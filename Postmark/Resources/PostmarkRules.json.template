{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "comment": "Postmark rule file TEMPLATE. The real rule file lives at ~/Library/Application Support/Postmark/PostmarkRules.json (created on first launch by copying this template). Git only ships this .template — never the real file. The Silo inbound address placeholders below MUST be replaced (the app refuses to forward to a placeholder, see the runtime guard).",
  "version": 1,
  "polling": {
    "intervalMinutes": 15,
    "daysWindow": 7,
    "enabled": false,
    "quietHours": {
      "start": "22:00",
      "end": "08:00"
    },
    "includeRead": false
  },
  "provider": {
    "type": "litellm",
    "baseURL": "http://127.0.0.1:4000/v1",
    "model": "openrouter/laguna-s-2.1"
  },
  "classifier": {
    "prompt": "Categorize this email as ONE of these categories. Reply with ONLY the category word.\n\nCategories:\n- low-priority: newsletters, mailing lists, marketing, notifications, automated alerts, promotions, emails from large platforms (Google, LinkedIn, Meta, etc.)\n- lead: enquiries from potential clients specifically about photography services (headshots, portraits, photo shoots, photography availability/rates/booking). Do NOT use this for DIT, digital imaging technician, data wrangling, or any non-photography professional work.\n- receipt: purchase receipts and invoices for money spent (NOT invoices from me)\n- other: anything else including personal, business, important emails, and professional enquiries that are NOT photography (e.g. DIT work, digital imaging, data management on set)\n\nEmail subject: {{subject}}\nFrom: {{fromName}} <{{fromEmail}}>\nBody: {{body}}\n\nCategory:"
  },
  "rules": [
    {
      "id": "lead",
      "label": "Leads",
      "action": {
        "markRead": true,
        "draftReply": true,
        "draftPrompt": "You are an AI email assistant. You receive the text of an incoming lead enquiry about photography services, along with knowledge about my business.\n\nYour job is to draft a professional reply to this potential client.\n\nRules:\n- Always output valid JSON only.\n- Provide a professional but concise reply draft.\n- If the query includes dates, check the sender's proposed dates against the email and include sensible options.\n- If the context suggests including a price in the reply, try to cost the job using the information available.\n- Keep tone polite, clear, and non-salesy. Don't use exclamation marks. Don't use the em dash.\n\nOutput format:\n{\n  \"suggested_reply\": \"Draft reply here\"\n}\n\nHere is the message:\n\n{{body}}"
      }
    },
    {
      "id": "receipt",
      "label": "Receipts",
      "action": {
        "move": "Receipts & Bookkeeping",
        "markRead": true,
        "forwardTo": ""
      }
    },
    {
      "id": "low-priority",
      "label": "Low Priority",
      "action": {
        "move": "Low Priority"
      }
    },
    {
      "id": "other",
      "label": "Other",
      "action": {
        "leave": true
      }
    }
  ],
  "fallback": {
    "action": {
      "leave": true
    }
  },
  "attachment": {
    "prompt": "You are filing production-day paperwork for a freelance camera operator/DIT. Given an email's subject/sender/body and a list of attachment filenames (with text excerpts where available), classify EACH attachment into exactly one of these categories, and extract the date it actually relates to (e.g. the shoot day the document covers) — NOT the date the email arrived.\n\nCategories:\n- Call Sheets\n- Movement Orders\n- Risk Assessments\n- Storyboards\n- Treatments\n- Specs (technical delivery / transcode / offline-edit specs for a shoot's deliverables)\n- Other (ONLY if you are confident it is shoot-day production logistics tied to a specific job, e.g. location maps/directions, shot lists, shoot schedules — but doesn't fit the categories above)\n- skip (the DEFAULT — use this unless you are confident the attachment is genuinely one of the categories above)\n\nUse \"skip\" for: invoices, quotations/quotes for kit, equipment or services, payroll/payslips/tax/HMRC forms, screenshots, personal photos, email signature images or logos, marketing material, newsletters, calendar invites, or anything you are not confident about. When in doubt, skip — false negatives are fine, false positives are not.\n\nFor the date: look at the filename, the text excerpt, and the email body for an explicit date (e.g. \"Shoot Day 4 - 10 July 2026\", \"MOVEMENT ORDER 08TH JULY\"). Resolve relative phrases (\"tomorrow\", \"for tomorrow\") against the email's received date, given below. If a document covers multiple days, use the FIRST day it covers. If you cannot determine a date with reasonable confidence, omit the date field (or set it to null) — do not guess.\n\nEmail received date: {{receivedDate}}\nEmail subject: {{subject}}\nFrom: {{fromName}} <{{fromEmail}}>\nEmail body (excerpt): {{bodyExcerpt}}\n\nAttachments:\n{{attachments}}\n\nReply with ONLY a JSON array, no markdown, no explanation, in this exact format:\n[{\"filename\": \"...\", \"category\": \"...\", \"date\": \"YYYY-MM-DD\"}]",
    "forward": {
      "to": "REPLACE_WITH_YOUR_Silo_INBOUND_ADDRESS",
      "onlyTypes": [
        "Call Sheets",
        "Movement Orders",
        "Risk Assessments",
        "Storyboards",
        "Treatments",
        "Specs"
      ]
    }
  }
}